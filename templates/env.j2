{# `PORT` and otherwise falls back to 3000. Without this, changing            #}
{# `redmine_container_http_port` would only move the port that Traefik and    #}
{# the published host port point at, while Puma kept listening on 3000.       #}
PORT={{ redmine_container_http_port }}

