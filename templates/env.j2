TZ={{ redmine_environment_variables_tz }}

{#
  The image's command is `rails server -b 0.0.0.0`, which takes its port from
  `PORT` and otherwise falls back to 3000. Without this, changing
  `redmine_container_http_port` would only move the port that Traefik and
  the published host port point at, while Puma kept listening on 3000.
#}
PORT={{ redmine_container_http_port }}

{% if redmine_path_prefix != '/' %}
{#
  The reverse-proxy configuration strips the path prefix before the request
  reaches Redmine, so Redmine keeps routing at `/`. What it does not know
  without this is that the URLs it generates - assets, links, redirects -
  have to carry the prefix, or the browser sends them back to a path the
  proxy does not route.
#}
RAILS_RELATIVE_URL_ROOT={{ redmine_path_prefix }}

{% endif %}
